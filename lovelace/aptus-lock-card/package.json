{
  "name": "aptus-lock-card",
  "version": "0.1.0",
  "description": "Home Assistant Lovelace card for Aptus door locks",
  "type": "module",
  "source": "src/aptus-lock-card.ts",
  "module": "dist/aptus-lock-card.js",
  "browserslist": "ios >= 12, android >= 5, last 2 versions, > 0.5%, not dead",
  "targets": {
    "module": {
      "includeNodeModules": true,
      "isLibrary": false,
      "outputFormat": "esmodule",
      "optimize": true
    }
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "NODE_ENV=production parcel build --no-source-maps",
    "postbuild": "cp dist/aptus-lock-card.js ../../custom_components/aptus/www/aptus-lock-card.js",
    "watch": "parcel watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.6",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "parcel": "^2.12.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
